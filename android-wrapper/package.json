{
  "name": "khazna-android",
  "version": "2.0.0",
  "description": "Khazna Password Manager — Android APK wrapper via Capacitor",
  "private": true,
  "scripts": {
    "build": "echo 'No build step needed — static PWA'",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/clipboard": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
